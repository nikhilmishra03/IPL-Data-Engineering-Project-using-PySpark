1. Imports

from pyspark.sql.functions import *
from pyspark.sql.types import *
from pyspark.sql.window import Window

2. Load Dataset

df = spark.read.format("csv").option("header", "true").option("inferSchema", "true").load("s3a://ipl-data-project-trying/ipl_data.csv")

3. Schema Validation

df.printSchema()

4. Null Value Analysis

df.select([
    sum(col(c).isNull().cast("int")).alias(c)
    for c in df.columns
]).show()

5. Remove Duplicates

df = df.dropDuplicates()

6. Total Matches

df.select("mid").distinct().count()

7. Highest Scoring Matches

df.groupBy("mid").agg(sum("runs").alias("total_runs")).orderBy(desc("total_runs")).show(10)

8. Lowest Scoring Matches

df.groupBy("mid").agg(sum("runs").alias("total_runs")).orderBy("total_runs").show(10)

9. Average Runs Per Match

df.groupBy("mid").agg(sum("runs").alias("match_runs")).agg(avg("match_runs")).show()

10. Team With Most Runs

df.groupBy("bat_team").agg(sum("runs").alias("team_runs")).orderBy(desc("team_runs")).show()

11. Team With Most Wickets

df.groupBy("bowl_team").agg(sum("wickets").alias("team_wickets")).orderBy(desc("team_wickets")).show()

12. Team vs Team Analysis

df.groupBy("bat_team", "bowl_team").agg(sum("runs").alias("runs_scored")).show()

13. Top Batsmen

df.groupBy("batsman").agg(sum("runs").alias("career_runs")).orderBy(desc("career_runs")).show(10)

14. Most Consistent Batsmen

df.groupBy("batsman").agg(stddev("runs").alias("consistency")).orderBy("consistency").show(10)

15. Top Bowlers

df.groupBy("bowler").agg(sum("wickets").alias("career_wickets")).orderBy(desc("career_wickets")).show(10)

16. Bowling Efficiency

df.groupBy("bowler").agg((sum("wickets") / sum("overs")).alias("efficiency")).orderBy(desc("efficiency")).show(10)

17. Highest Scoring Venue

df.groupBy("venue") .agg(avg("runs").alias("avg_runs")).orderBy(desc("avg_runs")).show()

18. Venue With Most Wickets

df.groupBy("venue").agg(sum("wickets").alias("total_wickets")).orderBy(desc("total_wickets")).show()

19. Running Total Using Window Function

windowSpec = Window.partitionBy("mid").orderBy("overs")

df = df.withColumn(
    "running_runs",
    sum("runs").over(windowSpec)
)

20. Rank Batsmen

batsman_df = df.groupBy("batsman").agg(sum("runs").alias("career_runs"))

windowSpec = Window.orderBy(desc("career_runs"))

ranked_df = batsman_df.withColumn(
    "rank",
    rank().over(windowSpec)
)

ranked_df.show()

21. Pressure Overs Feature

df = df.withColumn(
    "pressure_over",
    when(col("overs") > 15, "YES")
    .otherwise("NO")
)

22. Aggressive Batsman Feature

df = df.withColumn(
    "batsman_type",
    when(col("runs") > 10, "Aggressive")
    .otherwise("Normal")
)

23. Create SQL View

df.createOrReplaceTempView("ipl")

24. SQL Analytics - Top Batsmen

spark.sql("""
SELECT batsman,
       SUM(runs) AS total_runs
FROM ipl
GROUP BY batsman
ORDER BY total_runs DESC
LIMIT 10
""").show()

25. SQL Analytics - Top Bowlers

spark.sql("""
SELECT bowler,
       SUM(wickets) AS total_wickets
FROM ipl
GROUP BY bowler
ORDER BY total_wickets DESC
LIMIT 10
""").show()

26. SQL Analytics - Venue Analysis

spark.sql("""
SELECT venue,
       AVG(runs) AS avg_runs
FROM ipl
GROUP BY venue
ORDER BY avg_runs DESC
""").show()
